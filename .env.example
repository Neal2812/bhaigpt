# ---------------------------------------------------------------------------
# BhaiGPT configuration. Copy to `.env` and fill in. NEVER commit your .env.
# ---------------------------------------------------------------------------

# --- LLM (pick at least one; both are FREE tiers, no card required) ---
# Groq   -> https://console.groq.com/keys   (primary, very fast)
GROQ_API_KEY=
# Google Gemini -> https://aistudio.google.com/app/apikey  (fallback)
GEMINI_API_KEY=

# --- Burner X (Twitter) account for scraping via twscrape ---
# Use a THROWAWAY account, not a personal one. Only used locally by
# scrape/setup_account.py to authenticate the scraper.
X_USERNAME=
X_PASSWORD=
X_EMAIL=
X_EMAIL_PASSWORD=
# Optional: paste cookies string instead of password login if you have it.
X_COOKIES=
