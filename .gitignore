# Secrets & env
.env
*.env
!.env.example

# Scraped data & artifacts — keep raw dumps, DBs, and heavy indexes out of git.
# EXCEPTION: data/tweet_texts.json (the plain tweet text list) may be committed
# so the hosted app stays grounded in real tweets without shipping torch.
data/*
!data/tweet_texts.json
*.db
*.db-journal
*.sqlite

# Embedding index (heavy; hosted app runs without it)
*.faiss
*.npy

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
